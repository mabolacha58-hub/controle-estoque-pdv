{
  "name": "controle-estoque-pdv",
  "version": "2.0.0",
  "description": "Sistema PDV/ERP para controle de estoque - Electron Desktop",
  "author": "Controle de Estoque",
  "license": "MIT",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "set NODE_ENV=development && electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:mac": "electron-builder --mac",
    "postinstall": "node node_modules/electron/install.js"
  },
  "build": {
    "appId": "com.controleestoque.pdv",
    "productName": "Controle de Estoque PDV",
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "venv",
        "to": "venv",
        "filter": ["**/*"]
      },
      {
        "from": "app.py",
        "to": "app.py"
      },
      {
        "from": "config.py",
        "to": "config.py"
      },
      {
        "from": "auth.py",
        "to": "auth.py"
      },
      {
        "from": "database.py",
        "to": "database.py"
      },
      {
        "from": "database_enterprise.py",
        "to": "database_enterprise.py"
      },
      {
        "from": "extensions.py",
        "to": "extensions.py"
      },
      {
        "from": "routes",
        "to": "routes"
      },
      {
        "from": "services",
        "to": "services"
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "static",
        "to": "static"
      },
      {
        "from": "utils",
        "to": "utils"
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": ".env",
        "to": ".env"
      },
      {
        "from": "desktop_launcher.py",
        "to": "desktop_launcher.py"
      },
      {
        "from": "controle_estoque.db",
        "to": "controle_estoque.db"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "electron/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Controle de Estoque PDV",
      "installerIcon": "electron/icon.ico",
      "uninstallerIcon": "electron/icon.ico",
      "installerHeaderIcon": "electron/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "electron/icons",
      "category": "Office"
    },
    "mac": {
      "target": ["dmg"],
      "icon": "electron/icon.icns",
      "category": "public.app-category.business"
    }
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "electron-store": "^10.0.0",
    "electron-updater": "^6.3.9"
  }
}
